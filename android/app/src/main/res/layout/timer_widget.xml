<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
        <TextView android:id="@+id/widget_job" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"
            android:maxLines="1" android:ellipsize="end" />
        <Chronometer android:id="@+id/widget_elapsed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_action" android:layout_width="48dp"
        android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp"
        android:padding="12dp" android:background="@android:color/transparent"
        android:scaleType="centerInside" android:importantForAccessibility="yes" />
</LinearLayout>
