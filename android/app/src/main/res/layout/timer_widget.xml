<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#123B36">
    <TextView android:id="@+id/widget_job" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" />
    <Chronometer android:id="@+id/widget_elapsed" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#FFFFFF" />
    <Button android:id="@+id/widget_action" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" />
</LinearLayout>
