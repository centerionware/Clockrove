<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Disabled by default; Actions opts into the deterministic camera for
             its debug-only run. Release builds do not contain this component. -->
        <meta-data android:name="io.github.centerionware.clockrove.CI_CAMERA_FIXTURE"
            android:value="${clockroveCiCameraFixture}" />
        <activity android:name=".testsupport.TaskPhotoCameraActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".widget.WidgetTestHostActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
