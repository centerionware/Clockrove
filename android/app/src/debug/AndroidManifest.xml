<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Non-exported deterministic camera targeted only by Actions' debug
             instrumentation. Release builds do not contain this component. -->
        <activity android:name=".testsupport.TaskPhotoCameraActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".widget.WidgetTestHostActivity" android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
